# Copy to `.env` at the repo root (docker-compose reads it).
# Never commit real secrets.
#
# One set of Postgres names. The official db image and the API both read these.
# Do not also add DB_USER / DB_PASSWORD / DB_NAME — those are aliases only.
# Compose sets DB_HOST=db and DB_PORT=5432 inside the api container.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mirror_image
POSTGRES_PORT=5433

JWT_SECRET=dev-only-change-me-mirror-image
JWT_EXPIRE_HOURS=168

# --- Frontend URLs (one place for CORS + Stripe return links) ---
# development | production
APP_ENV=development
# Primary public site (used when browser origin is missing / not allowlisted)
FRONTEND_URL=http://127.0.0.1:3000
# Optional comma-separated allowlist. Leave empty in development to auto-include
# local docker/Vite hosts. In production, set explicitly, e.g.:
# FRONTEND_ORIGINS=https://mirrorimage.example,https://www.mirrorimage.example
FRONTEND_ORIGINS=

# Stripe (Dashboard → Developers → API keys; Product catalog → Price id)
# Use test keys (sk_test_...) while developing.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional default tier label written to users.subscription_type
STRIPE_SUBSCRIPTION_TYPE=standard supporter
# From `stripe listen --forward-to localhost:8000/billing/webhook` (whsec_...)
STRIPE_WEBHOOK_SECRET=


# Google Sign-In (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
# Use a Web application client. Authorized JavaScript origins must include FRONTEND_URL.
GOOGLE_CLIENT_ID=
# Frontend (Vite) — same Web client id as GOOGLE_CLIENT_ID
# IMPORTANT: Vite bakes VITE_* at image build time. Rebuild frontend after changes:
#   docker compose build --no-cache frontend && docker compose up -d frontend
VITE_GOOGLE_CLIENT_ID=

# Playtester: skip WebRTC so ICE/STUN never shows the other seat your IP.
# Messages stay on the room WebSocket. Rebuild frontend after changing this.
VITE_PLAY_RELAY_ONLY=true