# Copy to `.env` at the repo root (docker-compose reads it).
# Never commit real secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mirror_image
POSTGRES_PORT=5433

JWT_SECRET=dev-only-change-me-mirror-image
JWT_EXPIRE_HOURS=168

# --- Frontend URLs (one place for CORS + Stripe return links) ---
# development | production
APP_ENV=development
# Primary public site (used when browser origin is missing / not allowlisted)
FRONTEND_URL=http://127.0.0.1:3000
# Optional comma-separated allowlist. Leave empty in development to auto-include
# local docker/Vite hosts. In production, set explicitly, e.g.:
# FRONTEND_ORIGINS=https://mirrorimage.example,https://www.mirrorimage.example
FRONTEND_ORIGINS=

# Stripe (Dashboard → Developers → API keys; Product catalog → Price id)
# Use test keys (sk_test_...) while developing.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional default tier label written to users.subscription_type
STRIPE_SUBSCRIPTION_TYPE=standard supporter
# From `stripe listen --forward-to localhost:8000/billing/webhook` (whsec_...)
STRIPE_WEBHOOK_SECRET=
