# Production template — copy to `.env` on the VPS and edit every secret.
# Never commit `.env`.
#
# Quick start:
#   cp .env.production.example .env
#   nano .env
#   bash ./scripts/check-production-env.sh
#   bash ./scripts/deploy-production.sh

# --- Public hostnames (nginx reverse proxy + browser) ---
SITE_DOMAIN=mirrorimagetcg.net
API_DOMAIN=api.mirrorimagetcg.net

# --- Database (internal to Docker network only in production) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=mirror_image
# Not published in production compose; kept for migrate/backup scripts.
POSTGRES_PORT=5433

# --- Auth ---
JWT_SECRET=CHANGE_ME_at_least_32_random_bytes
JWT_EXPIRE_HOURS=168

# --- App URLs (must match live HTTPS) ---
APP_ENV=production
FRONTEND_URL=https://mirrorimagetcg.net
FRONTEND_ORIGINS=https://mirrorimagetcg.net,https://www.mirrorimagetcg.net
APP_PUBLIC_URL=https://mirrorimagetcg.net

# Baked into frontend image at build time — must match API_DOMAIN.
VITE_API_URL=https://api.mirrorimagetcg.net

# --- Stripe (start with test keys; switch to live when ready) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SUBSCRIPTION_TYPE=standard supporter
STRIPE_WEBHOOK_SECRET=

# --- Google Sign-In ---
# Authorized JavaScript origins: FRONTEND_URL (+ www if used).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Outbound email (verify / password reset) ---
# Cloudflare Email Routing receives mail; use Resend, Postmark, SES, etc. to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=noreply@mirrorimagetcg.net

# --- Field encryption (Phase 1+ — see PRIVACY_AND_DATA_PROTECTION.md) ---
# Generate: openssl rand -base64 32
# DATA_ENCRYPTION_KEY=
# SEARCH_HMAC_KEY=
# ENCRYPTION_ENABLED=true

# --- Optional: WebRTC TURN for future remote playtester ---
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
