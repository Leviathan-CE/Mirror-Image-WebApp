# Rendered by the official nginx image (envsubst) from SITE_DOMAIN / API_DOMAIN.
# HTTP — works with Cloudflare SSL mode "Flexible" (HTTPS visitor → HTTP origin).

server {
    listen 80;
    server_name www.${SITE_DOMAIN};
    return 301 https://${SITE_DOMAIN}$request_uri;
}

server {
    listen 80;
    server_name ${SITE_DOMAIN};

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name ${API_DOMAIN};

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;

    location / {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
